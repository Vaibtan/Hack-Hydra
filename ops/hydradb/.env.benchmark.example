# Copy to .env.benchmark, set unique non-production values, and do not commit it.
# AWS credentials below authorize only the isolated benchmark MinIO instance.
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-password
AWS_ACCESS_KEY_ID=replace-with-minio-access-key
AWS_SECRET_ACCESS_KEY=replace-with-minio-secret-password
