{
  "name": "palimpsest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "probe": "pnpm --filter @palimpsest/hydra run probe",
    "ingest-transcript": "pnpm --filter @palimpsest/palimpsest run ingest-transcript",
    "turn": "pnpm --filter @palimpsest/palimpsest run turn",
    "extract": "pnpm --filter @palimpsest/eval run extract",
    "ingest": "pnpm --filter @palimpsest/palimpsest run ingest",
    "stats": "pnpm --filter @palimpsest/palimpsest run stats",
    "slots": "pnpm --filter @palimpsest/palimpsest run slots",
    "ask": "pnpm --filter @palimpsest/palimpsest run ask",
    "ingest-slice": "pnpm --filter @palimpsest/eval run ingest-slice",
    "backfill-user": "pnpm --filter @palimpsest/eval run backfill-user",
    "eval": "pnpm --filter @palimpsest/eval run eval",
    "serve": "pnpm --filter @palimpsest/server run serve",
    "smoke": "pnpm --filter @palimpsest/server run smoke",
    "retrieval-metrics": "pnpm --filter @palimpsest/eval run retrieval-metrics",
    "trajectory": "pnpm --filter @palimpsest/palimpsest run trajectory"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
